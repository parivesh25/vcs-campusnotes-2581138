#!/usr/bin/env bash

IFS= read -r subject < "$1"
subject=${subject%$'\r'}

if [ "${#subject}" -lt 10 ]; then
    echo "commit-msg: blocked. Use at least 10 characters."
    exit 1
fi

case "$subject" in
    feat:*|fix:*|docs:*|refactor:*|chore:*) exit 0 ;;
    *) echo "commit-msg: blocked. Use feat:, fix:, docs:, refactor: or chore:."; exit 1 ;;
esac
